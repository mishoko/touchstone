 "conventions": {
  "measure": "loss_p = NAV_before(p) - NAV_after(p) for p in (sqrtSpot, sqrtS0, sqrtRef), a later leg replacing only on a strictly larger loss; charge = max(0, max loss); pStar = argmax (sqrtSpot on a tie, incl. charge 0); pStar is the argmax of the signed loss also when every leg is a gain; navBurn = min over the three legs of NAV_after(p); burn = ceilDiv(charge*S, navBurn) (0 when charge = 0; type(uint256).max when navBurn = 0 and charge > 0); burnR = ceilDiv((charge + reserve)*S, navBurn) - burn (type(uint256).max when saturated); ok = burn + burnR <= unvested + bond, evaluated without overflow (both may be type(uint256).max).",
  "settleExtra": "(s15, the fee-aware settlement) legs, in order, sqrtAt(max(MIN_TICK, tickMk - feeTicks)), sqrtAt(tickMk), sqrtAt(min(MAX_TICK, tickMk + feeTicks + 1)); nb = NAV(before, p) + F(before, pend.s0, p, up); na = NAV(after, p) + F(after, pend.sEnd, p, down); g = nb - na; a leg with g > 0 replaces one with g <= 0, between positive legs a later one replaces when g_new*nb_cur > g_cur*nb_new; loss = max(0, g); burnS = min(reserveShares, max(0, ceilDiv(loss*sAct, nb) - burn0)); extra = mulDiv(burnS, nb, sAct) (0 when sAct = 0). F per spec \u00a73.4 (feePips the pool's LP fee).",
  "NAV": "NAV(s) = q(idle0 + x_pos(s), s) + idle1 + y_pos(s); positions per Appendix A with roundUp = false.",
  "value": "ExecLedger.value(h, sqrtP) = (NAV(sqrtP), val(x_pos, y_pos, sqrtP)).",
  "holdings": "Holdings {idle0, idle1, L, lo, hi}; before/after are inputs.",
  "fields": "ExecLedger.measure in {before, after, sqrtS0, sqrtSpot, sqrtRef, reserve, S, unvested, bond} out {charge, pStar, navBurn, burn, burnR, ok}; ExecLedger.settleExtra in {before, after, pend {s0, sEnd, charge0, reserve, burn0, sAct}, tickMk, feeTicks, feePips, reserveShares} out {extra, pMk, burnS}; ExecLedger.value in {h, sqrtP} out {nav, posValue}; Holdings = {idle0, idle1, L, lo, hi}."
 },
