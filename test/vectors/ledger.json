{
 "schema": "touchstone-vectors/1",
 "specVersion": "2.26",
 "conventions": {
  "measure": "loss_p = NAV_before(p) - NAV_after(p) for p in (sqrtSpot, sqrtRef); charge = max(0, max loss); pStar = argmax, sqrtSpot on a tie (incl. charge 0); navAfterPStar = NAV_after(pStar); burn = ceilDiv(charge*S, navAfterPStar) (0 when charge = 0; type(uint256).max when navAfterPStar = 0 and charge > 0); ok = burn <= unvested + bond.",
  "NAV": "NAV(s) = q(idle0 + x_pos(s), s) + idle1 + y_pos(s); positions per Appendix A with roundUp = false.",
  "value": "ExecLedger.value(h, sqrtP) = (NAV(sqrtP), val(x_pos, y_pos, sqrtP)).",
  "holdings": "Holdings {idle0, idle1, L, lo, hi}; before/after are inputs.",
  "fields": "ExecLedger.measure in {before, after, sqrtSpot, sqrtRef, S, unvested, bond} out {charge, pStar, navAfterPStar, burn, ok}; ExecLedger.value in {h, sqrtP} out {nav, posValue}; Holdings = {idle0, idle1, L, lo, hi}."
 },
